executable            = submit_postprocess.sh
arguments             = $(workflow) $(year) $(basedir) $(x509path)

output                = condor/logs/$(workflow)/$(year)/postprocess/$(workflow)_postprocess.$(ClusterId).out
error                 = condor/logs/$(workflow)/$(year)/postprocess/$(workflow)_postprocess.$(ClusterId).err
log                   = condor/logs/$(workflow)/$(year)/postprocess/$(workflow)_postprocess.$(ClusterId).log

should_transfer_files = YES

request_memory        = 32 GB
request_cpus          = 8 

getenv                = True

+JobFlavour           = "longlunch"
+SingularityImage     = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/coffeateam/coffea-dask-almalinux9:2026.5.0-py3.13"

queue